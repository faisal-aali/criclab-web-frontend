# Dev proxy target for Vite (rewrites /api → this host). Default: http://127.0.0.1:8000
# Only used when VITE_API_BASE is unset.
# VITE_BACKEND_URL=http://127.0.0.1:8000

# API base for fetch(). Leave unset in local-backend dev so requests use /api (proxied).
# Production backend:
VITE_API_BASE=https://criclab-api-nine.vercel.app
