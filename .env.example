# Dev proxy target for Vite (rewrites /api → this host). Default: http://127.0.0.1:8000
# VITE_BACKEND_URL=http://127.0.0.1:8000

# API base for fetch(). Leave unset in local dev so requests use /api (proxied).
# For split production deploys, set the absolute backend URL, e.g.:
# VITE_API_BASE=https://api.example.com
