{
  "id": "/",
  "name": "CricLab",
  "short_name": "CricLab",
  "description": "Turn a phone video of a delivery into measured, coachable cricket insight.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
